# ==================================================
# LINKEDIN REFERRAL AGENT CONFIGURATION (.env)
# ==================================================

# 1. Agent Operational Mode
# Set to True for testing without sending real LinkedIn connection messages.
# Set to False to send real connection requests.
DRY_RUN=True

# 2. Search Parameters
SEARCH_KEYWORDS="AI Engineer"
SEARCH_LOCATION="India"

# 3. Execution Limits
# Maximum number of distinct companies to process per run
MAX_COMPANIES_TO_PROCESS=10

# Maximum number of people to message per company (default: 3)
MAX_PEOPLE_PER_COMPANY=3

# Maximum messages per day (default: unlimited or set a safety threshold)
MAX_MESSAGES_PER_DAY=100

# 4. User Introduction (Used directly in drafted connection notes)
USER_INTRODUCTION="I am a Software Engineer specializing in Python, Playwright automation, and AI integrations."

# 5. AI & Profile Configuration (Optional / Evaluation)
GEMINI_API_KEY="your_gemini_api_key_here"
LLM_MODEL="gemini-flash-latest"

USER_RESUME="I am a Software Engineer with experience in Python, TypeScript, and React."
USER_PREFERENCES="Looking for remote or hybrid AI Engineer roles."
